<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <queries>
        <package android:name="app.petallibrary" />
        <provider android:authorities="app.petallibrary.localsync" />
    </queries>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <application android:label="@string/app_name" android:icon="@mipmap/ic_arioso"
        android:theme="@style/AriosoTheme"
        android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules" android:usesCleartextTraffic="false">
        <!-- Every entry point checks Library's UID package and pinned certificate at runtime. -->
        <provider android:name=".AriosoPositionProvider"
            android:authorities="${applicationId}.petalpositions" android:exported="true"
            tools:ignore="ExportedContentProvider" />
        <!-- Keep MainActivity enabled for saved shortcuts, widget/service and reader intents. -->
        <activity android:name=".MainActivity" android:exported="true" />
        <activity android:name=".LauncherActivity" android:exported="false"
            android:theme="@android:style/Theme.NoDisplay" android:taskAffinity=""
            android:noHistory="true" android:excludeFromRecents="true" />
        <activity-alias android:name=".LauncherDefault" android:targetActivity=".LauncherActivity"
            android:enabled="true" android:exported="true"
            android:icon="@mipmap/ic_arioso" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherPage" android:targetActivity=".LauncherActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_page" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherArcs" android:targetActivity=".LauncherActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_arcs" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherShiba" android:targetActivity=".LauncherActivity"
            android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_shiba" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <service android:name=".PlaybackService" android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>
        <service android:name=".AriosoCarBrowserService" android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <receiver android:name=".AriosoWidget" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/arioso_widget_info" />
        </receiver>
    </application>
</manifest>
